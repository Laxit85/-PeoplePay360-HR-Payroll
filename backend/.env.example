# PeoplePay360 Backend Environment Configuration Template
PORT=4000
NODE_ENV=development

# Database Configuration (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peoplepay360

# JWT Authentication
JWT_SECRET=peoplepay360_secret_jwt_2026
JWT_EXPIRES_IN=8h

# ========================================================
# Email & Payroll Distribution Configuration
#
# 1. To send real emails via GMAIL:
#    - Enable 2-Step Verification on your Google Account
#    - Generate an App Password (16 letters): https://myaccount.google.com/apppasswords
#    - Set EMAIL_SERVICE=gmail
#    - Set SMTP_USER=your_email@gmail.com
#    - Set SMTP_PASSWORD=your_16_letter_app_password
#    - Set SMTP_FROM="PeoplePay360 Payroll" <your_email@gmail.com>
#
# 2. To test without setup (Mock Ethereal Email):
#    - Leave SMTP_USER and SMTP_PASSWORD empty. Ethereal mock inbox will be auto-used.
# ========================================================
EMAIL_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Background Scheduler
# Default: 23:59 on days 28-31 of every month (runs on the last day of each month)
PAYROLL_CRON_SCHEDULE=59 23 28-31 * *
